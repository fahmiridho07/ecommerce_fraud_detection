# Public repository scope: final thesis artifacts only.
# Keep the working repository tidy even after local experiment folders remain.
/*
!/.gitignore
!/README.md
!/LICENSE

# Dataset provenance only. The IEEE-CIS source files stay local/Kaggle.
!/data/
/data/*
!/data/README.md

# One locked Kaggle implementation of the final method.
!/kaggle/
/kaggle/*
!/kaggle/ieee_final_oversampling_kaggle.py

# One final, narrative notebook.
!/notebooks/
/notebooks/*
!/notebooks/final_methodology_ae_latent_oversampling.ipynb
